#!/bin/sh
# Writes the standard generated configuration on first install. State goes
# under $SNAP_COMMON, which every revision shares, so a refresh keeps the
# trust anchor history.
set -e

conf="$SNAP_DATA/sdns.conf"
if [ ! -f "$conf" ]; then
    cd "$SNAP_COMMON"
    "$SNAP/bin/sdns" -t -c "$conf" >/dev/null
    sed -i "s|^directory = \"db\"|directory = \"$SNAP_COMMON/db\"|" "$conf"
fi
