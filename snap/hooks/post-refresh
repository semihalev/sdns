#!/bin/sh
# A configuration written by an older snap uses a layout sdns no longer
# loads. Move it aside and write the standard generated file in its place;
# the settings carry across by hand.
set -e

conf="$SNAP_DATA/sdns.conf"
if [ -f "$conf" ] && grep -q '^\[server\]' "$conf"; then
    mv "$conf" "$conf.legacy"
fi
if [ ! -f "$conf" ]; then
    cd "$SNAP_COMMON"
    "$SNAP/bin/sdns" -t -c "$conf" >/dev/null
    sed -i "s|^directory = \"db\"|directory = \"$SNAP_COMMON/db\"|" "$conf"
fi
